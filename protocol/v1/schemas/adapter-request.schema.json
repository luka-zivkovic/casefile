{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:casefile:trust-benchmark:adapter-request:v1",
  "title": "Casefile trust-benchmark adapter request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "caseId",
    "artifactRoot",
    "track",
    "runIndex",
    "timeoutMs",
    "environmentId",
    "toolIdentityDigest"
  ],
  "properties": {
    "protocolVersion": { "const": 1 },
    "caseId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "artifactRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "track": {
      "enum": ["common-static-skill", "breadth"]
    },
    "runIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "environmentId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:@/+\\-]{0,255}$"
    },
    "toolIdentityDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
