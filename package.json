{
  "name": "casefile",
  "version": "0.1.0",
  "description": "npm audit for agent capabilities \u2014 static trust/audit scanner for agent skills, plugins, and marketplaces.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "casefile": "dist/cli.js",
    "casefile-benchmark-adapter": "dist/trust-benchmark-adapter-cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "benchmark",
    "protocol"
  ],
  "scripts": {
    "build": "tsc",
    "benchmark": "npm run build && node dist/benchmark.js benchmark/manifest.json",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.30",
    "ajv": "^8.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luka-zivkovic/casefile.git"
  }
}
